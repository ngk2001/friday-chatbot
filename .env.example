# PostgreSQL Connection String (from Neon.tech or Supabase.com free tier)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth / Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-random-32-byte-secret"
NEXTAUTH_SECRET="replace-with-random-32-byte-secret"
NEXTAUTH_URL="https://your-app.vercel.app"

# Primary AI Provider (Free tier at https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional Free Fallback AI (https://console.groq.com)
GROQ_API_KEY=""

# Optional OAuth Login Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

